# Appwrite shared persistence (server only). Preferred when configured.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=REPLACE_WITH_SERVER_SECRET
APPWRITE_DATABASE_ID=meetcool
# Provision private tables once: python scripts/setup_appwrite.py
# Export your real environment values before launching the server or setup script.

# Optional shared persistence. Set these only in the server/Vercel environment.
# Apply database/schema.sql to the chosen Supabase project first.
# Never add a service key to static files, browser code, URLs or source control.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_REPLACE_WITH_SERVER_SECRET

# Local-only fallback when both Supabase values above are absent:
# MEETCOOL_DB=/absolute/path/to/meetcool.sqlite3
# Vercel has no SQLite fallback: without shared storage, shared meetings are disabled.

# Canonical origin used in receipt links (server only).
PUBLIC_APP_URL=https://meetcool-three.vercel.app
# Optional email delivery: enable an email provider in Appwrite Messaging.
# Key scopes: providers.read, messages.write, messages.read.
# Without a provider, meetings still work and email_status is unconfigured.
